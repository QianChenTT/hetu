{
  "id": "search",
  "name": "Search",
  "version": "0.1.0",
  "api": "^1",
  "entries": { "worker": "dist/worker.js" },
  "requires": ["luoshu"],
  "provides": { "actions": { "query": {} }, "topics": ["indexed"] },
  "capabilities": [
    { "type": "luoshu.read", "paths": ["**"] },
    { "type": "events.subscribe", "topics": ["luoshu.changed", "luoshu.outside"] }
  ]
}
