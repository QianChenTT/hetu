{
  "name": "hetu-core",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    "./api/*": "./api/*",
    "./lib/*": "./lib/*"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p api && tsc --noEmit -p frontend",
    "test": "vitest run",
    "test:e2e": "vitest run --config test/e2e/vitest.config.ts",
    "test:packaged": "vitest run --config test/packaged/vitest.config.ts",
    "test:installed": "vitest run --config test/installed/vitest.config.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@humanwhocodes/momoa": "^3.3.13",
    "@lezer/common": "^1.5.4",
    "@lezer/markdown": "^1.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
