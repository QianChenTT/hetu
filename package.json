{
  "name": "hetu",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "main": "core/dist/main.js",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "core",
    "core/sdk",
    "daemon",
    "editor",
    "plugins/capabilities",
    "plugins/exec",
    "plugins/gate",
    "plugins/history",
    "plugins/layout",
    "plugins/luoshu",
    "plugins/storage",
    "plugins/search"
  ],
  "scripts": {
    "dev": "node scripts/dev.ts",
    "seed": "npm run seed -w daemon",
    "seed:fresh": "npm run seed -w daemon -- --fresh",
    "test": "npm test -w core -w daemon -w plugins/capabilities -w plugins/exec -w plugins/gate -w plugins/history -w plugins/layout -w plugins/luoshu -w plugins/storage -w plugins/search --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build:main": "node core/build/main.ts",
    "test:e2e": "npm run build:main && npm run test:e2e -w hetu-core",
    "package:dir": "node core/build/package.ts dir",
    "package": "node core/build/package.ts installer",
    "package:driven": "node core/build/package.ts driven",
    "test:packaged": "npm run package:dir && npm run test:packaged -w hetu-core",
    "test:e2e:packaged": "npm run build:main && node scripts/e2e-packaged.ts"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "playwright": "1.65.0"
  }
}
