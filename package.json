{
  "name": "hetu",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "main": "core/dist/main.js",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "core",
    "core/sdk",
    "daemon",
    "editor",
    "core-plugins/mcp-http-handler",
    "core-plugins/layout",
    "core-plugins/search"
  ],
  "scripts": {
    "dev": "node scripts/dev.ts",
    "seed": "npm run seed -w daemon",
    "seed:fresh": "npm run seed -w daemon -- --fresh",
    "test": "npm test -w core -w daemon -w core-plugins/mcp-http-handler -w core-plugins/layout -w core-plugins/search --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check:copies": "node scripts/check-copies.ts",
    "build:main": "node core/build/main.ts",
    "test:e2e": "npm run build:main && npm run test:e2e -w hetu-core",
    "package:dir": "node core/build/package.ts dir",
    "package": "node core/build/package.ts installer",
    "package:driven": "node core/build/package.ts driven",
    "test:packaged": "npm run package:dir && npm run test:packaged -w hetu-core",
    "test:e2e:packaged": "npm run build:main && node scripts/e2e-packaged.ts",
    "measure:bridge": "node scripts/measure-bridge.ts"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "electron": "45.3.0",
    "electron-builder": "26.18.0",
    "hetu-plugins": "github:QianChenTT/hetu-plugins#1169fd132a3e4870933f80fa21bdb5bc241905c3",
    "jscpd": "5.4.3",
    "playwright": "1.65.0"
  }
}
