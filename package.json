{
  "name": "hetu",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "core/dist/main.js",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "core",
    "core/sdk",
    "daemon",
    "editor",
    "plugins/capabilities",
    "plugins/gate",
    "plugins/luoshu",
    "plugins/storage",
    "plugins/search"
  ],
  "scripts": {
    "dev": "node scripts/dev.ts",
    "seed": "npm run seed -w daemon",
    "seed:fresh": "npm run seed -w daemon -- --fresh",
    "test": "npm test -w core -w daemon -w plugins/capabilities -w plugins/gate -w plugins/luoshu -w plugins/storage -w plugins/search --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build:main": "node core/build/main.ts",
    "test:e2e": "npm run build:main && npm run test:e2e -w hetu-core"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "playwright": "1.65.0"
  }
}
